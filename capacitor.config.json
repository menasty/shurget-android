{
  "appId": "com.shurget.app",
  "appName": "Shurget",
  "webDir": "www",
  "server": {
    "url": "https://shurgetapp.com",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "checkout.stripe.com",
      "*.stripe.com",
      "shurgetapp.com",
      "www.shurgetapp.com",
      "shurget.com",
      "www.shurget.com"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "Geolocation": {
      "permissions": {
        "location": "whenInUse"
      }
    },
    "Camera": {
      "permissions": [
        "camera",
        "photos"
      ]
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
