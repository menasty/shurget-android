{
  "appId": "com.shurget.app",
  "appName": "Shurget",
  "webDir": "www",
  "server": {
    "url": "https://shurgetapp.com",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Geolocation": {
      "permissions": {
        "location": "whenInUse"
      }
    },
    "Camera": {
      "permissions": ["camera", "photos"]
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
